# Copiar a .env (local) o cargar en el panel del hosting (producción). Nunca subir .env al repositorio.

# --- Entorno: development | production ---
NODE_ENV=development
PORT=3000
# URL pública del sitio (links de los correos, CORS, redirecciones de pago)
APP_URL=http://localhost:3000
# Orígenes permitidos para la API, separados por coma (vacío = solo mismo origen)
CORS_ORIGINS=

# --- Base de datos ---
# development: archivo JSON local (data/db.json), sin instalar nada
DB_DRIVER=json
# production (cuando exista): cadena de conexión de Postgres/Supabase/Atlas
DATABASE_URL=

# --- Correo ---
# console = imprime y guarda en data/outbox | resend = envío real vía API
MAIL_DRIVER=console
MAIL_FROM=Costa Palmeras <no-responder@costapalmeras.com>
# Casilla que recibe los mensajes del formulario de contacto
MAIL_TO_CONTACT=contacto@costapalmeras.com
RESEND_API_KEY=

# --- Pagos ---
# mock = simulado local | mercadopago = real
PAYMENTS_DRIVER=mock
MP_ACCESS_TOKEN=

# --- Seguridad ---
# Cadena larga aleatoria (producción). Generar: openssl rand -hex 32
SESSION_SECRET=cambiar-en-produccion
# Rate limit: peticiones por minuto y por IP a /api
RATE_LIMIT_PER_MIN=60
